{
  "manifest_version": 3,
  "name": "B站每日必看",
  "short_name": "每日必看",
  "version": "0.2.4",
  "description": "根据你的 B站历史记录、榜单和增长数据，每天推荐必看视频，并统计你的观看标签。",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://api.bilibili.com/*", "https://www.bilibili.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 B站每日必看",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
